<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Flags this APK as a Tachiyomi/Mihon/Aniyomi extension. -->
    <uses-feature
        android:name="tachiyomi.extension"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Sacred Texts Library">

        <!-- Entry point: the SourceFactory implementation. -->
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value=".SacredTextsLibraryFactory" />

        <!-- 0 = safe for work. -->
        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="0" />

        <!-- Extension metadata read by modern apps. -->
        <meta-data
            android:name="tachiyomix.name"
            android:value="Sacred Texts Library" />
        <!-- 0 = safe, 1 = mixed, 2 = nsfw -->
        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="0" />
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="1.4" />
    </application>

</manifest>
